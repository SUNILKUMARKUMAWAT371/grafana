{
  "newPanels": [
    {
      "title": "MongoDB Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 40},
      "targets": [
        {
          "expr": "mongodb_up{cluster_role=\"mongod\"}",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          }
        }
      }
    },
    {
      "title": "CPU Utilization",
      "type": "graph",
      "gridPos": {"h": 6, "w": 12, "x": 4, "y": 40},
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "yaxes": [
        {"format": "percentunit"},
        {"format": "short"}
      ]
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": {"h": 6, "w": 12, "x": 16, "y": 40},
      "targets": [
        {
          "expr": "go_memstats_heap_alloc_bytes",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "yaxes": [
        {"format": "bytes"},
        {"format": "short"}
      ]
    },
    {
      "title": "Read IOPS",
      "type": "graph",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 46},
      "targets": [
        {
          "expr": "rate(node_disk_reads_completed_total[5m])",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "yaxes": [
        {"format": "iops"},
        {"format": "short"}
      ]
    },
    {
      "title": "Write IOPS",
      "type": "graph",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 46},
      "targets": [
        {
          "expr": "rate(node_disk_writes_completed_total[5m])",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "yaxes": [
        {"format": "iops"},
        {"format": "short"}
      ]
    },
    {
      "title": "Network Traffic (In/Out)",
      "type": "graph",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 52},
      "targets": [
        {
          "expr": "rate(process_network_receive_bytes_total[5m])",
          "refId": "A",
          "legendFormat": "Inbound"
        },
        {
          "expr": "rate(process_network_transmit_bytes_total[5m])",
          "refId": "B",
          "legendFormat": "Outbound"
        }
      ],
      "datasource": "Prometheus",
      "yaxes": [
        {"format": "bytes"},
        {"format": "short"}
      ]
    }
  ]
}
